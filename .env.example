# Azure Document Intelligence
AZURE_DOC_INTEL_KEY=your-doc-intel-key
AZURE_DOC_INTEL_ENDPOINT=https://doc-intel-hk.cognitiveservices.azure.com

# Azure Blob Storage (optional backup)
AZURE_BLOB_ACCOUNT=blobhk04472
AZURE_BLOB_CONTAINER=property-pdf
AZURE_BLOB_READ_SAS=your-sas-token

# Microsoft Graph API (OneDrive)
MS_GRAPH_CLIENT_ID=your-app-client-id
MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_SECRET=your-client-secret

# Azure OpenAI (embeddings)
AZURE_OPENAI_ENDPOINT=https://swedencentral.api.cognitive.microsoft.com
AZURE_OPENAI_KEY=your-openai-key

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://ai-search-hk-free.search.windows.net
AZURE_SEARCH_LISTING_INDEX=property-listing-vectors
AZURE_SEARCH_NEWS_INDEX=property-news-vectors
AZURE_SEARCH_API_KEY=your-search-key

# OpenRouter (classification/extraction)
OPENROUTER_API_KEY=your-openrouter-key

# LangSmith (observability)
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=document-processor
LANGCHAIN_TRACING_V2=true
