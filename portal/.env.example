# Supabase project "genie" (ref xhaqzwznduxoosqtcrrm). Values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xhaqzwznduxoosqtcrrm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public address of this site, used in sign-in and invitation links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (never NEXT_PUBLIC_). Supabase secret key: reads workspace AI keys from Vault, records usage.
SUPABASE_SECRET_KEY=
# Platform AI key used when a workspace has not added its own. Production uses OpenRouter only.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=   (supported, but not used in production)
# Optional model overrides.
# GENIE_ANTHROPIC_MODEL=claude-opus-5-5
# GENIE_OPENROUTER_MODEL=anthropic/claude-opus-5.5
# GENIE_XAI_MODEL=grok-4
